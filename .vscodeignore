!out/**/*.js # Include all compiled JS
!LICENSE.txt
!README.md
!CHANGELOG.md
!package.json
!img/icon.png # Include the main icon
# Include other necessary assets from img/ if needed

# Exclude map files if not needed for published debugging
out/**/*.js.map

