{
	"name": "flutter-dependency-docs",
	"version": "1.2.1",
	"publisher": "djbkwon",
	"displayName": "Flutter Links",
	"description": "Show pub.dev links for your Flutter dependencies.",
	"engines": {
		"vscode": "^1.60.0"
	},
	"license": "MIT",
	"categories": [
		"Other"
	],
	"icon": "img/icon.png",
	"scripts": {
		"vscode:prepublish": "yarn run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"postinstall": "node ./node_modules/vscode/bin/install",
		"test": "yarn run compile && node ./node_modules/vscode/bin/test"
	},
	"devDependencies": {
		"@types/mocha": "^2.2.42",
		"@types/node": "^10.12.21",
		"tslint": "^5.12.1",
		"typescript": "^3.8.3",
		"vscode": "^1.1.37"
	},
	"activationEvents": [
		"onLanguage:yaml"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "Flutter Links",
			"properties": {
				"flutterLinks.baseUrl": {
					"type": "string",
					"default": "https://pub.dev/",
					"description": "Base URL for Flutter package links (default: pub.dev)."
				}
			}
		},
		"commands": [
			{
				"command": "extension.viewDependencyWithParameter",
				"title": "Flutter Links: Open Package URL"
			},
			{
				"command": "extension.viewDependency",
				"title": "Flutter Links: Search pub.dev Package",
				"category": "Flutter Links"
			},
			{
				"command": "flutterLinks.show",
				"title": "Flutter Links: Show Links",
				"category": "Flutter Links",
				"icon": "$(eye-closed)"
			},
			{
				"command": "flutterLinks.hide",
				"title": "Flutter Links: Hide Links",
				"category": "Flutter Links",
				"icon": "$(eye)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "flutterLinks.show",
					"when": "resourceLangId == yaml && resourceFilename == pubspec.yaml && !flutterLinks:enabled",
					"group": "navigation",
					"tooltip": "Show Flutter Links"
				},
				{
					"command": "flutterLinks.hide",
					"when": "resourceLangId == yaml && resourceFilename == pubspec.yaml && flutterLinks:enabled",
					"group": "navigation",
					"tooltip": "Hide Flutter Links"
				}
			]
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/danieljbk/flutter-links.git"
	}
}