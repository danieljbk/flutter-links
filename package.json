{
	"name": "flutter-dependency-docs",
	"version": "1.2.0",
	"publisher": "djbkwon",
	"displayName": "Flutter Links",
	"description": "Show pub.dev links for your Flutter dependencies.",
	"engines": {
		"vscode": "^1.60.0"
	},
	"license": "MIT",
	"categories": [
		"Other"
	],
	"icon": "img/icon.png",
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/node": "^22.15.3",
		"@types/vscode": "^1.60.0",
		"typescript": "^5.8.3"
	},
	"activationEvents": [
		"onLanguage:yaml"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "Flutter Links",
			"properties": {
				"flutterLinks.baseUrl": {
					"type": "string",
					"default": "https://pub.dev/",
					"description": "Base URL for Flutter package links (default: pub.dev)."
				}
			}
		},
		"commands": [
			{
				"command": "extension.viewDependencyWithParameter",
				"title": "Open Package URL"
			},
			{
				"command": "extension.viewDependency",
				"title": "Search pub.dev Package",
				"category": "Flutter Links"
			},
			{
				"command": "flutterLinks.show",
				"title": "Show pub.dev Links",
				"category": "Flutter Links",
				"icon": "./resources/eye-hidden.svg"
			},
			{
				"command": "flutterLinks.hide",
				"title": "Hide pub.dev Links",
				"category": "Flutter Links",
				"icon": "./resources/eye-visible.svg"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "flutterLinks.show",
					"when": "resourceLangId == yaml && resourceFilename == pubspec.yaml && !flutterLinks:enabled",
					"group": "navigation@2",
					"tooltip": "Show Flutter Links"
				},
				{
					"command": "flutterLinks.hide",
					"when": "resourceLangId == yaml && resourceFilename == pubspec.yaml && flutterLinks:enabled",
					"group": "navigation@2",
					"tooltip": "Hide Flutter Links"
				}
			]
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/danieljbk/flutter-links.git"
	}
}